---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');

// Curated order: pillar + highest-intent guides first.
const featured = [
  'bing-seo-for-shopify',
  'shopify-store-not-showing-up-on-bing',
  'add-indexnow-to-shopify',
  'get-shopify-products-into-chatgpt',
  'bing-discovered-but-not-crawled',
  'bing-webmaster-tools-for-shopify',
  'submit-shopify-sitemap-to-bing',
  'best-indexnow-apps-for-shopify',
];
posts.sort((a, b) => {
  const ai = featured.indexOf(a.id);
  const bi = featured.indexOf(b.id);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
---

<Base
  title="Bing SEO & Indexing Guides for Shopify | IndexNow.io"
  description="Practical guides to get your Shopify store indexed and visible on Bing, DuckDuckGo, ChatGPT and Copilot — from Webmaster Tools setup to IndexNow."
>
  <div class="page-header container">
    <h1>Guides</h1>
    <p>
      Everything you need to get your Shopify store indexed and visible on Bing —
      and the AI answers built on top of it.
    </p>
  </div>
  <div class="post-grid container">
    <div class="grid-2">
      {posts.map((post) => (
        <a class="card" href={`/blog/${post.id}/`}>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="read-more">Read guide →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
