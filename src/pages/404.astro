---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | IndexNow.io"
  description="That page isn't in our index. Browse Bing SEO guides for Shopify or install the free IndexNow app."
>
  <div class="page-header container">
    <span class="eyebrow">HTTP/1.1 404 Not Found</span>
    <h1>404 — not in the index</h1>
    <p>
      Ironic, we know. The page you're looking for doesn't exist — but these do:
    </p>
    <p style="margin-top: 28px;">
      <a href="/blog/" class="btn btn-primary">Browse guides</a>
      <a href="/" class="btn btn-secondary" style="margin-left: 10px;">Home</a>
    </p>
  </div>
  <div style="height: 80px;"></div>
</Base>
